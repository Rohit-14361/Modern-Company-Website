# Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digilabs?retryWrites=true&w=majority

# Gmail SMTP credentials
# Use a Gmail App Password (NOT your login password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Where contact form submissions get delivered
EMAIL_RECEIVER=your_gmail@gmail.com